export SEQ_SAREK_DBSNP_TBI="/path/to/references/gatk_bundle/dbsnp_144.hg38.vcf.gz.tbi"
export SEQ_SAREK_KNOWN_INDELS="/path/to/references/gatk_bundle/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz"
export SEQ_SAREK_KNOWN_INDELS_TBI="/path/to/references/gatk_bundle/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz.tbi"
export SEQ_SAREK_KNOWN_SNPS="/path/to/references/gatk_bundle/1000G_omni2.5.hg38.vcf.gz"
export SEQ_SAREK_KNOWN_SNPS_TBI="/path/to/references/gatk_bundle/1000G_omni2.5.hg38.vcf.gz.tbi"

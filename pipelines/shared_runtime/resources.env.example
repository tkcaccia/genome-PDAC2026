export SEQ_RNASEQ_STAR_INDEX="/path/to/references/gencode/star"
export SEQ_RNASEQ_SALMON_INDEX="/path/to/references/gencode/salmon"
export SEQ_GENCODE_TRANSCRIPTS="/path/to/references/gencode/gencode.v46.transcripts.fa.gz"

export SEQ_VEP_CACHE_ROOT="/path/to/references/vep/cache"

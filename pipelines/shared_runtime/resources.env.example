export SEQ_SAREK_GERMLINE_RESOURCE_TBI="/path/to/references/gatk_bundle/af-only-gnomad.hg38.vcf.gz.tbi"
export SEQ_SAREK_PON=""
export SEQ_SAREK_PON_TBI=""

export SEQ_RNASEQ_FASTA="/path/to/references/gencode/Homo_sapiens_GRCh38_46_dna_primary_assembly.fa"

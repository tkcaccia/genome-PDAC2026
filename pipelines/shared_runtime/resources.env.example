export SEQ_CLINVAR_VCF="/path/to/references/clinvar/clinvar.vcf.gz"
export SEQ_CLINVAR_TBI="/path/to/references/clinvar/clinvar.vcf.gz.tbi"
export SEQ_RNAFUSION_GENOMES_BASE="/path/to/references/fusion"

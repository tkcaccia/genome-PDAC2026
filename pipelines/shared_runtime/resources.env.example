# Copy this file to a private location, replace every /path/to placeholder, and
# point PDAC2026_RESOURCES_ENV to that private copy. Do not commit the filled file.

export SEQ_BASE="/path/to/pdac2026_runtime"
export SEQ_WORK="/path/to/restricted/nextflow_work"
export SEQ_RESULTS="/path/to/restricted/results"
export NXF_HOME="/path/to/pdac2026_runtime/tmp/nextflow"
export NXF_WORK="/path/to/restricted/nextflow_work"
export NXF_SINGULARITY_CACHEDIR="/path/to/pdac2026_runtime/containers/nextflow_singularity"
export NXF_APPTAINER_CACHEDIR="/path/to/pdac2026_runtime/containers/nextflow_apptainer"
export SINGULARITY_CACHEDIR="$NXF_SINGULARITY_CACHEDIR"
export APPTAINER_CACHEDIR="$NXF_APPTAINER_CACHEDIR"
export SEQ_RUNTIME_PROFILE="singularity"
export SEQ_SYNC_STARFUSION="false"
export SEQ_SYNC_FUSIONCATCHER="true"

export SEQ_SAREK_FASTA="/path/to/references/gatk_bundle/Homo_sapiens_assembly38.fasta"

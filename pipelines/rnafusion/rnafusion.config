// Bounded local profile used on a 31 GiB workstation. One task is allowed at
// a time, and no process may request more than 29 GB or four CPUs.
process {
    executor = 'local'
    maxForks = 1
    maxRetries = 2
    errorStrategy = { task.exitStatus in ((130..145) + 104 + 175) ? 'retry' : 'finish' }
    resourceLimits = [
        cpus: 4,
        memory: '29.GB',
        time: '72.h'
    ]

    // STAR is the largest expected process. Keep it below physical RAM.
    withName: 'STAR_ALIGN' {
        cpus = 4
        memory = '29.GB'
        time = '48.h'
    }

    withName: 'FUSIONCATCHER' {
        cpus = 4
        memory = '24.GB'
        time = '72.h'
    }
}

executor {
    queueSize = 1
    pollInterval = '2 sec'
}

singularity {
    enabled = true
    autoMounts = true
    cacheDir = System.getenv('NXF_SINGULARITY_CACHEDIR') ?:
        "${System.getProperty('user.home')}/.cache/nextflow/singularity"
}

timeline.enabled = true
report.enabled = true
trace {
    enabled = true
    fields = 'task_id,hash,native_id,name,status,exit,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,read_bytes,write_bytes'
}

params {
    no_cosmic = true
    genome = 'GRCh38'
    genome_gencode_version = 46
}

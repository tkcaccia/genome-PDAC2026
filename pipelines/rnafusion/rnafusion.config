process {
  executor = 'local'
  cpus = 2
  memory = '8.GB'
  time = '24.h'

  withLabel:process_single {
    cpus = 1
    memory = '4.GB'
    time = '8.h'
  }

  withLabel:process_low {
    cpus = 2
    memory = '8.GB'
    time = '12.h'
  }

  withLabel:process_medium {
    cpus = 4
    memory = '24.GB'
    time = '24.h'
  }

  withLabel:process_high {
    cpus = 8
    memory = '48.GB'
    time = '48.h'
  }

  withLabel:process_high_memory {
    cpus = 8
    memory = '48.GB'
    time = '48.h'
  }
}

singularity {
  enabled = true
  autoMounts = true
  cacheDir = '/media/user/SEQ/containers/nextflow_singularity'
}

apptainer {
  enabled = false
  autoMounts = true
  cacheDir = '/media/user/SEQ/containers/nextflow_apptainer'
}

params {
  outdir = '/media/user/SEQ/results/rnafusion'
  no_cosmic = true
  genome = 'GRCh38'
  genome_gencode_version = 46
}

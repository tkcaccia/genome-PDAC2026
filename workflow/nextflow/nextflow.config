manifest {
    name = 'PDAC Exome 2.5 WES and multi-omics rerun'
    nextflowVersion = '>=25.10.0'
}
params {
    mode = 'audit'
    python = 'python3'
    asset_root = null
    package_root = null
    run_root = null
    manifest = null
    reports_dir = "${launchDir}/nf_reports"
}
process {
    executor = 'local'
    errorStrategy = 'terminate'
    shell = ['/bin/bash', '-euo', 'pipefail']
}
singularity.enabled = false
docker.enabled = false
trace { enabled = true; file = "${params.reports_dir}/trace.tsv"; overwrite = true }
dag { enabled = true; file = "${params.reports_dir}/workflow.dot"; overwrite = true }
timeline { enabled = true; file = "${params.reports_dir}/timeline.html"; overwrite = true }
report { enabled = true; file = "${params.reports_dir}/report.html"; overwrite = true }
profiles {
    slurm {
        process.executor = 'slurm'
        process.queue = 'Main'
        executor.queueSize = 12
    }
}